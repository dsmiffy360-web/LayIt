# Copy this file to .env.local for local development.
# For production, set these same names in your host's environment
# variables (Vercel: Project Settings → Environment Variables).

# --- Supabase ---
# Project Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with VITE_ (that would expose it to the
# browser). Used only by api/stripe-webhook.js to bypass Row Level
# Security when writing subscription status.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Product catalog → your Contractor plan price → Price ID (starts with price_)
STRIPE_CONTRACTOR_PRICE_ID=price_...

# --- App ---
# Your deployed URL — used for Stripe checkout success/cancel redirects
PUBLIC_APP_URL=https://your-app.vercel.app
