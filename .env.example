# Copy this file to .env.local for local development.
# For production, set these same names in your host's environment
# variables (Vercel: Project Settings → Environment Variables).

# --- Supabase ---
# Project Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with VITE_ (that would expose it to the
# browser). Used only by api/stripe-webhook.js to bypass Row Level
# Security when writing subscription status.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Product catalog → your Contractor plan price → Price ID (starts with price_)
STRIPE_CONTRACTOR_PRICE_ID=price_...

# --- App ---
# Your deployed URL — used for Stripe checkout success/cancel redirects
PUBLIC_APP_URL=https://your-app.vercel.app

# --- Push notifications (job reminders) ---
# Generate a pair with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY must be the exact same value as VAPID_PUBLIC_KEY —
# one is read by the browser (subscribing), the other by the server
# (sending), and web-push will reject sends if they ever drift apart.
VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# A contact address the push services can reach you at if they need to
# (part of the Web Push spec, not shown to end users)
VAPID_SUBJECT=mailto:you@example.com
# Authenticates /api/send-reminders — Vercel auto-attaches this exact env
# var as a bearer token on scheduled Cron invocations (see vercel.json),
# so nobody else can trigger a mass notification blast by hitting the URL
CRON_SECRET=any-random-string

# --- Error monitoring ---
# sentry.io → your project → Settings → Client Keys (DSN). Same value in
# both — VITE_SENTRY_DSN ships in the client bundle (src/main.jsx),
# SENTRY_DSN is read server-side only (api/_sentry.js). Leave both unset
# to disable reporting entirely (e.g. in local dev).
VITE_SENTRY_DSN=https://xxxxx@xxxx.ingest.sentry.io/xxxxx
SENTRY_DSN=https://xxxxx@xxxx.ingest.sentry.io/xxxxx
